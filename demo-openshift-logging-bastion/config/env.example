# Copy to config/env.local and fill in values before install:
#   cp config/env.example config/env.local
#
# Do NOT commit config/env.local or config/secrets.env.

# Bastion syslog target (FQDN reachable from cluster worker egress)
export BASTION_SYSLOG_HOST="bastion.example.sandbox.opentlc.com"
export BASTION_SYSLOG_PORT="514"

# OpenShift Logging / Loki operator channels (match cluster OCP version)
export LOGGING_CHANNEL="stable-6.6"
export LOKI_CHANNEL="stable-6.6"
export COO_CHANNEL="stable"

# Cluster storage
export STORAGE_CLASS="gp3-csi"

# MinIO object store for LokiStack (demo only — change before production)
export MINIO_ROOT_USER="changeme-minio-user"
export MINIO_ROOT_PASSWORD="changeme-minio-password-replace-me"
export MINIO_BUCKET="loki"

# Optional: label a demo app namespace for user-workload monitoring
export DEMO_APP_NAMESPACE="hello-world-app"
