# Example only — do not commit real tokens.
# Create the live secret on the cluster (see BOOTSTRAP.md).
apiVersion: v1
kind: Secret
metadata:
  name: fxrate-python-cve-upgrade-demo-repo
  namespace: openshift-gitops
  labels:
    argocd.argoproj.io/secret-type: repository
    app.kubernetes.io/part-of: fx-rate-demo
stringData:
  type: git
  name: fxrate-python-cve-upgrade-demo
  url: https://gitlab-gitlab.apps.<YOUR_CLUSTER_DOMAIN>/fxrate/python-cve-upgrade-demo.git
  username: oauth2
  password: REPLACE_WITH_GITLAB_PAT
  project: default
