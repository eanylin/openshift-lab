# Lab host parameterization — copy to cluster/lab.env (gitignored) and edit.
# Then:  ./cluster/scripts/set-lab-hosts.sh
#
# Most hosts are derived from APPS_DOMAIN:
#   nexus.${APPS_DOMAIN}  quay.${APPS_DOMAIN}
#   gitlab-gitlab.${APPS_DOMAIN}  sso.${APPS_DOMAIN}
#   *.apps.${APPS_DOMAIN} routes in docs

# ---------------------------------------------------------------------------
# Source = what is currently committed in this repo
# ---------------------------------------------------------------------------
SOURCE_APPS_DOMAIN=apps.<YOUR_CLUSTER_DOMAIN>

# ---------------------------------------------------------------------------
# Target = the lab you are moving to (edit these)
# ---------------------------------------------------------------------------
APPS_DOMAIN=apps.<YOUR_CLUSTER_DOMAIN>

# Optional overrides (defaults = prefix + APPS_DOMAIN)
# QUAY_HOST=quay.apps.example.com
# GITLAB_HOST=gitlab-gitlab.apps.example.com
# NEXUS_HOST=nexus.apps.example.com
# SSO_HOST=sso.apps.example.com

# GitLab project path (host changes with APPS_DOMAIN; path usually stays)
GITLAB_PROJECT=fxrate/python-cve-upgrade-demo

# After rewriting hosts: rebuild Quay images, refresh digests.env, re-pin overlays.
