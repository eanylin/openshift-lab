# Act 2 — community python:3.12-slim + T1 hashed lock (spec §5.3).
# Install: --require-hashes --no-deps --only-binary=:all:
# Act 3a replaces this base with RHHI multi-stage.

ARG ACT2_BASE=docker.io/library/python@sha256:44ff437bba879d4941b710a369a8f19266aea34b29002807f0c487fabc9eec9b

FROM ${ACT2_BASE}
WORKDIR /opt/app

RUN useradd --uid 1001 --gid 0 --create-home --home-dir /opt/app appuser \
    && chown -R 1001:0 /opt/app \
    && chmod -R g=u /opt/app

COPY requirements.txt /tmp/requirements.txt
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --index-url "${PIP_INDEX_URL}" \
         --require-hashes --no-deps --only-binary=:all: \
         -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY fxrate/ /opt/app/fxrate/
COPY demo_ui.html /opt/app/demo_ui.html
RUN chown -R 1001:0 /opt/app /opt/venv && chmod -R g=u /opt/app /opt/venv

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH="/opt/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
USER 1001
EXPOSE 8080
LABEL \
  demo.fxrate.act="2" \
  org.opencontainers.image.version="2.0.0-act2"

ENTRYPOINT ["gunicorn", "-b", "0.0.0.0:8080", "fxrate:app"]
