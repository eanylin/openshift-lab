# Act 3b — RHHI multi-stage + Trusted Libraries T2 lock (provenance).
# Index is Nexus hosted pypi-hosted-rhtl (TL wheel bytes, relative URLs).
# Populate: bash cluster/nexus/hosted-rhtl/populate-hosted-rhtl.sh
# Digests from digests.env (constitution I).

ARG RHHI_BUILDER=registry.access.redhat.com/hi/python@sha256:95e23e434d7c047ab9bc540d8ec3c665c1f815179dd1c3b7aa06627d2feecc64
ARG RHHI_RUNTIME=registry.access.redhat.com/hi/python@sha256:f703228646dfeae7a962d1ee720e5cb16031dcfee88eb064453dcefd09670e05

FROM ${RHHI_BUILDER} AS build
USER 0
WORKDIR /opt/app

COPY requirements-t2.txt /tmp/requirements.txt
# Hosted T2 mirror (same TL wheel bytes; relative URLs — no packages.redhat.com from CI).
ARG PIP_INDEX_URL=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-hosted-rhtl/simple
ARG PIP_TRUSTED_HOST=nexus.apps.<YOUR_CLUSTER_DOMAIN>
# pip itself from PyPI Nexus — app lock comes from the hosted T2 index only.
ARG PIP_TOOLING_INDEX_URL=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-proxy-pypi/simple
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
         --index-url "${PIP_TOOLING_INDEX_URL}" \
         --trusted-host "${PIP_TRUSTED_HOST}" \
         --retries 15 --timeout 120 \
    && /opt/venv/bin/pip install --index-url "${PIP_INDEX_URL}" \
         --trusted-host "${PIP_TRUSTED_HOST}" \
         --retries 15 --timeout 120 \
         --require-hashes --no-deps --only-binary=:all: \
         -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY fxrate/ /opt/app/fxrate/
COPY demo_ui.html /opt/app/demo_ui.html
RUN chown -R 0:0 /opt/app /opt/venv && chmod -R g=u /opt/app /opt/venv

FROM ${RHHI_RUNTIME}
COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/app /opt/app
WORKDIR /opt/app

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH="/opt/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080
LABEL \
  demo.fxrate.act="3b" \
  org.opencontainers.image.version="3.0.0-act3b"

ENTRYPOINT ["/opt/venv/bin/gunicorn", "-b", "0.0.0.0:8080", "fxrate:app"]
