# Lightwell Network backport mock (lab only — NOT product content).
# Same RHHI multi-stage as Containerfile.act3b; dependency feed is Nexus hosted
# pypi-hosted-rhlw with Act 0 upstream + PEP 440 local (urllib3==1.26.14+rhlw-0001).
# Contrast Act 3b TL upgrade (flask 3.1.3). See cluster/docs/LIGHTWELL-MOCK.md.

ARG RHHI_BUILDER=registry.access.redhat.com/hi/python@sha256:95e23e434d7c047ab9bc540d8ec3c665c1f815179dd1c3b7aa06627d2feecc64
ARG RHHI_RUNTIME=registry.access.redhat.com/hi/python@sha256:f703228646dfeae7a962d1ee720e5cb16031dcfee88eb064453dcefd09670e05

FROM ${RHHI_BUILDER} AS build
USER 0
WORKDIR /opt/app

COPY requirements-rhlw.txt /tmp/requirements.txt
ARG PIP_INDEX_URL=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-hosted-rhlw/simple
ARG PIP_TRUSTED_HOST=nexus.apps.<YOUR_CLUSTER_DOMAIN>
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --index-url "${PIP_INDEX_URL}" \
         --trusted-host "${PIP_TRUSTED_HOST}" \
         --require-hashes --no-deps --only-binary=:all: \
         -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY fxrate/ /opt/app/fxrate/
COPY demo_ui.html /opt/app/demo_ui.html
RUN chown -R 0:0 /opt/app /opt/venv && chmod -R g=u /opt/app /opt/venv

FROM ${RHHI_RUNTIME}
COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/app /opt/app
WORKDIR /opt/app

ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH="/opt/app" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080
LABEL \
  demo.fxrate.act="3b-rhlw" \
  demo.fxrate.index="lightwell-mock" \
  org.opencontainers.image.version="3.0.0-rhlw"

ENTRYPOINT ["/opt/venv/bin/gunicorn", "-b", "0.0.0.0:8080", "fxrate:app"]
