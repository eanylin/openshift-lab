# Nexus Repository CE (pin RepoDigest from podman inspect, not image Id)
NEXUS_IMAGE=docker.io/sonatype/nexus3
NEXUS_IMAGE_DIGEST=sha256:5266e8c9019c89759ca7575048ba7eb50efa0479ccd75dcbe4f208b0dfc68d98
NEXUS_IMAGE_REF=docker.io/sonatype/nexus3@sha256:5266e8c9019c89759ca7575048ba7eb50efa0479ccd75dcbe4f208b0dfc68d98
NEXUS_URL=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>
NEXUS_URL_INTERNAL=http://nexus.nexus.svc:8081
NEXUS_PYPI_SIMPLE=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-proxy-pypi/simple
# Act 3b CI/build index: hosted T2 mirror (TL wheel bytes, relative URLs).
# Populate: bash cluster/nexus/hosted-rhtl/populate-hosted-rhtl.sh
NEXUS_RHTL_SIMPLE=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-hosted-rhtl/simple
# Upstream TL simple root (populate source only; absolute CDN links — do not use from fxrate-ci).
NEXUS_RHTL_RAW=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/raw-proxy-rhtl/
# Lab mock of Lightwell backport index (Act 0 +rhlw-0001; see cluster/docs/LIGHTWELL-MOCK.md).
NEXUS_RHLW_SIMPLE=https://nexus.apps.<YOUR_CLUSTER_DOMAIN>/repository/pypi-hosted-rhlw/simple
NEXUS_TRUSTED_HOST=nexus.apps.<YOUR_CLUSTER_DOMAIN>
